# ==============================================================================
# Scientific Paper "Gap Finder" - Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Scientific Paper Gap Finder"
VERSION="0.1.0"
API_V1_PREFIX=/api/v1

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (JSON array of strings)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scientific_gap_finder
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=scientific_gap_finder
# If true and PostgreSQL connection fails, falls back to SQLite for local Phase 0 development
ALLOW_SQLITE_DEV_FALLBACK=true

# LLM Provider Configuration (Pluggable Abstraction: gemini, openai, local)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_API_KEY_BACKUP=
OPENAI_API_KEY=
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
DEFAULT_LLM_MODEL=gemini-3.8-flash

# NLP & Embedding Settings (Prepared for Phase 1)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
SPACY_MODEL=en_core_web_sm
TOPIC_MODEL_ALGORITHM=BERTopic

# Storage & Vector Search Paths
DATA_DIR=./data
FAISS_INDEX_PATH=./data/embeddings/faiss_index.bin
METADATA_DIR=./data/metadata

# Logging Settings
LOG_LEVEL=INFO
LOG_FORMAT=json

# Frontend Configuration (used by Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1
